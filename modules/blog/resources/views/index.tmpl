<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{ .title }}</title>
</head>
<body>
    <h1>{{ .title }}</h1>
    {{ range .posts }}
    <article>
        <h2>{{ .Title }}</h2>
        <p>{{ .Body }}</p>
    </article>
    {{ end }}
</body>
</html>
